# Copy to backend/.env for local development. Never commit backend/.env.
# These are safe local defaults; replace placeholders before use.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=180days_local

# Local browser origin. Production uses the single Vercel app origin.
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
APP_TZ=Asia/Kolkata

# Generate a unique random value of at least 32 bytes.
JWT_SECRET=replace-with-a-unique-random-jwt-secret

# Optional values used by the insert-only admin provisioning helper.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-password

# Gmail SMTP. Use a Gmail App Password; never use the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=180dayys@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=180dayys@gmail.com
SMTP_FROM_NAME=180Days
SMTP_USE_TLS=true

# Legacy Resend settings are retained for existing environments but are unused.
RESEND_API_KEY=
FROM_EMAIL=
EMAIL_FROM_NAME=180Days

# Generate a separate unique random value for scheduled reminder requests.
CRON_SECRET=replace-with-a-different-random-cron-secret
